#!/bin/bash

# Interactive compression with archive type selection
compress_interactive() {
  echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
  echo "📦 Select Archive Type:"
  echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
  echo "  1) ZIP       - Universal, fast, widely supported"
  echo "  2) TAR       - Unix standard, no compression"
  echo "  3) TAR.GZ    - TAR + GZIP compression (good balance)"
  echo "  4) TAR.BZ2   - TAR + BZIP2 compression (better ratio)"
  echo "  5) TAR.XZ    - TAR + XZ compression (best ratio, slower)"
  echo "  6) 7Z        - 7-Zip, excellent compression"
  echo "  7) RAR       - WinRAR format (if rar installed)"
  echo "  8) TAR.ZST   - TAR + Zstandard (fast + good ratio)"
  echo "  9) ISO       - CD/DVD image format"
  echo " 10) JAR       - Java archive (ZIP-based)"
  echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
  echo -n "Enter choice [1-10]: "
  read choice

  case $choice in
    1) compress_zip "$@" ;;
    2) compress_tar "$@" ;;
    3) compress_targz "$@" ;;
    4) compress_tarbz2 "$@" ;;
    5) compress_tarxz "$@" ;;
    6) compress_7z "$@" ;;
    7) compress_rar "$@" ;;
    8) compress_tarzst "$@" ;;
    9) compress_iso "$@" ;;
    10) compress_jar "$@" ;;
    *)
      echo "❌ Invalid choice. Please select 1-10."
      exit 1
      ;;
  esac
}

compress_zip() {
  local output="compressed_files.zip"
  echo "📦 Compressing to ZIP..."
  zip -r "$output" "$@" > /dev/null
  echo "✅ Created: $output"
}

compress_tar() {
  local output="compressed_files.tar"
  echo "📦 Compressing to TAR..."
  tar -cf "$output" "$@"
  echo "✅ Created: $output"
}

compress_targz() {
  local output="compressed_files.tar.gz"
  echo "📦 Compressing to TAR.GZ..."
  tar -czf "$output" "$@"
  echo "✅ Created: $output"
}

compress_tarbz2() {
  local output="compressed_files.tar.bz2"
  echo "📦 Compressing to TAR.BZ2..."
  tar -cjf "$output" "$@"
  echo "✅ Created: $output"
}

compress_tarxz() {
  local output="compressed_files.tar.xz"
  echo "📦 Compressing to TAR.XZ..."
  tar -cJf "$output" "$@"
  echo "✅ Created: $output"
}

compress_7z() {
  local output="compressed_files.7z"
  echo "📦 Compressing to 7Z..."
  7z a "$output" "$@" > /dev/null
  echo "✅ Created: $output"
}

compress_rar() {
  local output="compressed_files.rar"
  if command -v rar &> /dev/null; then
    echo "📦 Compressing to RAR..."
    rar a "$output" "$@" > /dev/null
    echo "✅ Created: $output"
  else
    echo "❌ Error: RAR not installed (apt install rar)"
    exit 1
  fi
}

compress_tarzst() {
  local output="compressed_files.tar.zst"
  if command -v zstd &> /dev/null; then
    echo "📦 Compressing to TAR.ZST..."
    tar --zstd -cf "$output" "$@"
    echo "✅ Created: $output"
  else
    echo "❌ Error: zstd not installed (apt install zstd)"
    exit 1
  fi
}

compress_iso() {
  local output="compressed_files.iso"
  if command -v genisoimage &> /dev/null; then
    echo "📦 Creating ISO image..."
    genisoimage -o "$output" -R -J "$@" > /dev/null 2>&1
    echo "✅ Created: $output"
  elif command -v mkisofs &> /dev/null; then
    echo "📦 Creating ISO image..."
    mkisofs -o "$output" -R -J "$@" > /dev/null 2>&1
    echo "✅ Created: $output"
  else
    echo "❌ Error: genisoimage/mkisofs not installed (apt install genisoimage)"
    exit 1
  fi
}

compress_jar() {
  local output="compressed_files.jar"
  if command -v jar &> /dev/null; then
    echo "📦 Compressing to JAR..."
    jar -cf "$output" "$@"
    echo "✅ Created: $output"
  else
    echo "📦 Compressing to JAR (using zip)..."
    zip -r "$output" "$@" > /dev/null
    echo "✅ Created: $output"
  fi
}

# Function to extract files based on file type from the 'file' command or by file extension
extract_file() {
  local file_path="$1"

  # Use 'file' command to determine the type of the file
  file_info=$(file "$file_path")

  echo "File info: $file_info"

  # Check the output from the 'file' command to determine how to decompress the file
  if [[ "$file_info" =~ "gzip compressed data" ]] || [[ "$file_info" =~ "GZIP compressed data" ]]; then
    echo "Extracting gzip file..."
    if command -v pigz &> /dev/null; then
      pigz -d "$file_path"
    else
      gzip -d "$file_path"
    fi
  elif [[ "$file_info" =~ "bzip2 compressed data" ]] || [[ "$file_info" =~ "BZIP2 compressed data" ]]; then
    echo "Extracting bzip2 file..."
    bzip2 -dk "$file_path"
  elif [[ "$file_info" =~ "XZ compressed data" ]] || [[ "$file_info" =~ "XZ Compressed data" ]]; then
    echo "Extracting xz file..."
    unxz "$file_path"
  elif [[ "$file_info" =~ "Zstandard compressed data" ]] || [[ "$file_info" =~ "ZSTD compressed data" ]]; then
    echo "Extracting zstd file..."
    unzstd "$file_path"
  elif [[ "$file_info" =~ "Zip archive data" ]] || [[ "$file_info" =~ "ZIP archive data" ]]; then
    echo "Extracting zip file..."
    unzip "$file_path"
  elif [[ "$file_info" =~ "RAR archive data" ]] || [[ "$file_info" =~ "rar archive data" ]]; then
    echo "Extracting rar file..."
    unrar x "$file_path"
  elif [[ "$file_info" =~ "7-zip archive data" ]]; then
    echo "Extracting 7z file..."
    7z x "$file_path"
  elif [[ "$file_info" =~ "LZ4 compressed data" ]]; then
    echo "Extracting LZ4 file..."
    lz4 -d "$file_path" "${file_path%.lz4}"
  elif [[ "$file_info" =~ "POSIX tar archive" ]] || [[ "$file_info" =~ "TAR archive data" ]]; then
    echo "Extracting tar file..."
    tar -xf "$file_path"
  elif [[ "$file_info" =~ "ZPAQ archive" ]]; then
    echo "Extracting zpaq file..."
    zpaq x "$file_path"
  elif [[ "$file_info" =~ "KGB Archiver file" ]]; then
    echo "Extracting kgb file..."
    kgb "$file_path"
  else
    # If 'file' command doesn't recognize the type, fall back to extension
    ext="${file_path##*.}"
    echo "Falling back to extension method: $ext"
    case "$ext" in
      gz)
        echo "Extracting gzip file based on extension..."
        if command -v pigz &> /dev/null; then
          pigz -d "$file_path"
        else
          gzip -d "$file_path"
        fi
        ;;
      bz2)
        echo "Extracting bzip2 file based on extension..."
        bzip2 -dk "$file_path"
        ;;
      xz)
        echo "Extracting xz file based on extension..."
        unxz "$file_path"
        ;;
      zst)
        echo "Extracting zstd file based on extension..."
        unzstd "$file_path"
        ;;
      zip)
        echo "Extracting zip file based on extension..."
        unzip "$file_path"
        ;;
      rar)
        echo "Extracting rar file based on extension..."
        unrar x "$file_path"
        ;;
      7z)
        echo "Extracting 7z file based on extension..."
        7z x "$file_path"
        ;;
      lz4)
        echo "Extracting LZ4 file based on extension..."
        lz4 -d "$file_path" "${file_path%.lz4}"
        ;;
      tar)
        echo "Extracting tar file based on extension..."
        tar -xf "$file_path"
        ;;
      zpaq)
        echo "Extracting zpaq file based on extension..."
        zpaq x "$file_path"
        ;;
      kgb)
        echo "Extracting kgb file based on extension..."
        kgb "$file_path"
        ;;
      *)
        echo "Unknown file type or unsupported extension: $ext"
        ;;
    esac
  fi
}

# Parse command line options
if [ "$1" == "-c" ]; then
  if [ -z "$2" ]; then
    echo "Usage: compr -c <files_to_compress>"
    exit 1
  fi
  compress_interactive "${@:2}"
  exit 0
fi

# Check if the file path is provided for decompression
if [ -z "$1" ] || [ "$1" == "-h" ] || [ "$1" == "--help" ]; then
  echo "Compress/Decompress Tool"
  echo ""
  echo "Usage:"
  echo "  compr -c <files...>    Compress files (interactive menu)"
  echo "  compr <archive>        Decompress/extract archive"
  echo ""
  echo "Examples:"
  echo "  compr -c file1.txt file2.txt folder/"
  echo "  compr archive.zip"
  exit 1
fi

if [ ! -f "$1" ] && [ "$1" != "-c" ]; then
  echo "Error: '$1' is not a valid file."
  exit 1
fi

# Call the extraction function with the provided file path
extract_file "$1"
