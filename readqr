#!/usr/bin/python3
#version 12.10.25

import argparse
from pyzbar.pyzbar import decode
from PIL import Image

def read_qr_code(image_path):
    """Read QR code from image file using pyzbar."""
    try:
        # Open the image
        img = Image.open(image_path)
        
        # Convert palette images with transparency to RGBA to avoid warnings
        if img.mode in ('P', 'PA') and 'transparency' in img.info:
            img = img.convert('RGBA')
        
        # Decode QR codes and barcodes
        decoded_objects = decode(img)
        
        if not decoded_objects:
            return "No QR code or barcode found in image."
        
        # Extract and return data from all found codes
        results = []
        for obj in decoded_objects:
            data = obj.data.decode('utf-8')
            code_type = obj.type
            results.append(f"[{code_type}] {data}")
        
        return "\n".join(results)
        
    except FileNotFoundError:
        return f"Error: File '{image_path}' not found."
    except Exception as e:
        return f"Error reading QR code: {str(e)}"

def main():
    parser = argparse.ArgumentParser(description="Read QR codes and barcodes from image files locally (no API needed).")
    parser.add_argument("image", help="Path to the image file containing QR code or barcode")
    
    args = parser.parse_args()
    
    # Read and decode QR code
    result = read_qr_code(args.image)
    print(result)

if __name__ == "__main__":
    main()
